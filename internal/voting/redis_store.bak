package voting

import (
	"context"
	"encoding/json"
	"fmt"

	"github.com/google/uuid"
	"github.com/redis/go-redis/v9"
)


type RedisStore struct {
	rdb *redis.Client
}

func NewRedisStore(rdb * redis.Client) *RedisStore {
	return &RedisStore{rdb: rdb}
}

func (s *RedisStore) AddProjects(p *Project) error {
    id := uuid.New().String()
    p.Id = id
    ctx := context.Background()
    key := "projects"  // Hash key
    
    val, err := json.Marshal(p)
    if err != nil {
        return err
    }
	if err := s.rdb.HSet(ctx, key, id, val).Err(); err != nil {
        return err
    }

// Initialize votes counter for this project
    votesKey := fmt.Sprintf("projects:%s:votes", id)
    return s.rdb.Set(ctx, votesKey, 0, 0).Err() // 0 means no expiration
 
}

func (s *RedisStore) ListProjects() ([]Project, error) {
    ctx := context.Background()
    key := "projects"
    
    // Get all fields and values
    val, err := s.rdb.HGetAll(ctx, key).Result()
    if err != nil {
        return nil, err
    }
    
    res := make([]Project, 0, len(val))
    for _, v := range val {
        var prj Project
        if err := json.Unmarshal([]byte(v), &prj); err != nil {
            // Better to return error instead of panic
            return nil, fmt.Errorf("failed to unmarshal project: %w", err)
        }
        res = append(res, prj)
    }
    return res, nil
}

func (s *RedisStore) CastVote(user_id string, project_id string) error {
    ctx := context.Background()
    
    // First, check if user exists
    usersKey := "users"
    exists, err := s.rdb.HExists(ctx, usersKey, user_id).Result()
    if err != nil {
        return fmt.Errorf("failed to check user existence: %w", err)
    }
    
    if !exists {
        return fmt.Errorf("user %s does not exist", user_id)
    }
    
    // Check if user already voted
    key := fmt.Sprintf("hasVoted:%s", user_id)
    res := s.rdb.SetArgs(ctx, key, "voted", redis.SetArgs{Mode: "NX"})
    if res.Val() != "Ok" {
        return UserAlreadyVoted
    }
    
    // Increment vote counter for the project
    votesKey := fmt.Sprintf("projects:%s:votes", project_id)
    _, err = s.rdb.Incr(ctx, votesKey).Result()
    if err != nil {
        // If increment fails, we should clean up the hasVoted key to maintain consistency
        s.rdb.Del(ctx, key)
        return fmt.Errorf("failed to increment vote counter: %w", err)
    }
    
    return nil
}

// Modified AddUser function
func (s *RedisStore) AddUser(user *User) (*User, error) {
    
    // TODO: Generate token here when implemented
    // user.Token = generateToken()
    
    ctx := context.Background()
    usersKey := "users"
    emailKey := "users:emails" // Separate hash/set for email lookups
    
    // Check if email already exists
    exists, err := s.rdb.HExists(ctx, emailKey, user.Email).Result()
    if err != nil {
        return nil, fmt.Errorf("failed to check email existence: %w", err)
    }
    
    if exists {
        return nil, fmt.Errorf("email %s already exists", user.Email)
    }
    
    // Marshal user to JSON
    val, err := json.Marshal(user)
    if err != nil {
        return nil, fmt.Errorf("failed to marshal user: %w", err)
    }
    
    // Use a transaction to ensure both operations succeed or fail together
    pipe := s.rdb.TxPipeline()
    
    // Store user in Redis hash
    if err := pipe.HSet(ctx, usersKey, user.Id, val).Err(); err != nil {
        return nil, fmt.Errorf("failed to store user: %w", err)
    }
    
    // Store email -> user_id mapping for quick lookups
    if err := pipe.HSet(ctx, emailKey, user.Email, user.Id).Err(); err != nil {
        return nil, fmt.Errorf("failed to store email mapping: %w", err)
    }
    
    // Execute the transaction
    if _, err := pipe.Exec(ctx); err != nil {
        return nil, fmt.Errorf("failed to save user data: %w", err)
    }
    
    return user, nil
}


